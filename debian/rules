#!/usr/bin/make -f

APPPKG = debian/mmassx
MODPKG = debian/mmassx-modules

%:
	dh $@ --with python3 --buildsystem=none

# The top-level setup.py only has Windows/macOS (py2exe/py2app)
# branches; force buildsystem=none above so dh doesn't try to
# auto-detect it as a python_distutils build. mspy/calculations is a
# mandatory C extension with no fallback (see debian/patches), and
# that does need building.
override_dh_auto_build:
	cd mspy && python3 setup.py build_ext --inplace
	rm -rf mspy/build

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf $(APPPKG) $(MODPKG) mspy/build mspy/*.so mspy/__pycache__

# Mirrors the split the original mmass package used: platform-
# independent files in the arch:all "mmassx" package, and the one
# compiled extension in the arch:any "mmassx-modules" package. Unlike
# that old package, mmassx's mmass.py uses Python 3's explicit
# relative imports (`from . import calculations`), which require
# calculations.so to resolve inside mspy/'s own package directory, a
# PYTHONPATH pointing at a separate directory (what the old package
# did) will not satisfy that. Instead mmassx-modules ships the real
# .so under /usr/lib/mmassx/mspy/, and mmassx ships a relative symlink
# to it from its own mspy/ directory, so the package looks whole to
# Python once both are installed together (guaranteed by the
# mmassx-modules (>= ${binary:Version}) dependency in debian/control).
override_dh_auto_install:
	dh_installdirs -pmmassx \
		usr/share/mmassx/mspy usr/bin usr/share/applications \
		usr/share/icons/hicolor/16x16/apps usr/share/icons/hicolor/32x32/apps \
		usr/share/icons/hicolor/48x48/apps usr/share/icons/hicolor/128x128/apps \
		usr/share/icons/hicolor/256x256/apps
	dh_installdirs -pmmassx-modules usr/lib/mmassx/mspy

	# arch:all package: everything except the compiled extension
	cp -a mmass.py gui configs $(APPPKG)/usr/share/mmassx/
	cp -a mspy/*.py $(APPPKG)/usr/share/mmassx/mspy/
	cp readme.md changelog.md license.txt $(APPPKG)/usr/share/mmassx/
	rm -rf $(APPPKG)/usr/share/mmassx/gui/images/msw $(APPPKG)/usr/share/mmassx/gui/images/mac
	# Upstream's git repo carries the executable bit on plain data and
	# .py files (they're imported, never run directly); strip it.
	find $(APPPKG)/usr/share/mmassx -type f -exec chmod 644 {} +
	install -m 755 debian/mmassx.wrapper $(APPPKG)/usr/bin/mmassx
	install -m 644 debian/mmassx.desktop $(APPPKG)/usr/share/applications/mmassx.desktop
	install -m 644 gui/images/gtk/icon_16.png $(APPPKG)/usr/share/icons/hicolor/16x16/apps/mmassx.png
	install -m 644 gui/images/gtk/icon_32.png $(APPPKG)/usr/share/icons/hicolor/32x32/apps/mmassx.png
	install -m 644 gui/images/gtk/icon_48.png $(APPPKG)/usr/share/icons/hicolor/48x48/apps/mmassx.png
	install -m 644 gui/images/gtk/icon_128.png $(APPPKG)/usr/share/icons/hicolor/128x128/apps/mmassx.png
	install -m 644 gui/images/gtk/icon_256.png $(APPPKG)/usr/share/icons/hicolor/256x256/apps/mmassx.png

	# arch:any package: only the compiled extension, plus the symlink
	# that makes it visible inside the arch:all package's mspy/ tree
	install -m 755 mspy/calculations*.so $(MODPKG)/usr/lib/mmassx/mspy/
	so_name=$$(basename mspy/calculations*.so); \
	ln -sf ../../../lib/mmassx/mspy/$$so_name $(APPPKG)/usr/share/mmassx/mspy/$$so_name
